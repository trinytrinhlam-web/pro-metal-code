#: template-parts/landing/cards.php:25
msgid "Vách panel phù hợp với những công trình cần chia không gian nhanh nhưng vẫn muốn sạch, nhẹ và dễ kiểm soát tiến độ. Thay vì xây tường gạch mất nhiều thời gian, nhiều bụi và khó thay đổi về sau, vách panel có thể lắp theo khung, ghép tấm, xử lý khe nối và đưa vào sử dụng nhanh hơn."
msgstr ""

#: template-parts/landing/cards.php:26
msgid "Tuy vậy, thi công panel không chỉ là dựng vài tấm vách lên. Công trình nhà xưởng cần tính độ cao, khung xương và độ ổn định. Văn phòng trong xưởng cần nhìn gọn, kín, đủ sáng. Phòng trọ cần tối ưu chi phí và dễ vệ sinh. Kho mát hoặc khu phụ trợ lại cần chú ý khả năng cách nhiệt và cách xử lý khe nối."
msgstr ""

#: template-parts/landing/cards.php:27
msgid "Pro-Metal đi theo hướng tư vấn trước khi thi công: xem mục đích sử dụng, đo kích thước, kiểm tra nền/tường/trần hiện trạng, rồi mới đề xuất loại panel, độ dày, khung phụ và cách hoàn thiện."
msgstr ""

#: template-parts/landing/cards.php:45
msgid "Vách panel phù hợp công trình nào?"
msgstr ""

#: template-parts/landing/cards.php:46
msgid "Mỗi mặt bằng cần một cách làm khác nhau. Chúng tôi ưu tiên tư vấn theo mục đích sử dụng để không chọn vật tư quá thiếu hoặc quá dư."
msgstr ""

#: template-parts/landing/cards.php:52
msgid "Vách panel nhà xưởng"
msgstr ""

#: template-parts/landing/cards.php:53
msgid "Chia khu làm việc, kho phụ, phòng kỹ thuật hoặc khu cần ngăn bụi/giảm nóng tương đối. Điểm quan trọng là khung xương chắc, chân vách neo ổn và chiều cao phù hợp."
msgstr ""

#: template-parts/landing/cards.php:56
msgid "Văn phòng trong xưởng"
msgstr ""

#: template-parts/landing/cards.php:57
msgid "Làm phòng quản lý, phòng họp nhỏ, khu admin hoặc phòng nghỉ. Có thể kết hợp cửa đi, ô kính và trần panel để tách khu rõ hơn."
msgstr ""

#: template-parts/landing/cards.php:60
msgid "Phòng trọ, nhà cho thuê"
msgstr ""

#: template-parts/landing/cards.php:61
msgid "Phù hợp chia phòng nhanh, giảm tải trọng lên sàn và hạn chế thi công ướt. Cần tư vấn kỹ khe hở, điện và nhu cầu riêng tư."
msgstr ""

#: template-parts/landing/cards.php:64
msgid "Kho mát, khu phụ trợ"
msgstr ""

#: template-parts/landing/cards.php:65
msgid "Panel giúp hạn chế nóng và ổn định không gian hơn vách thường. Nếu là kho lạnh/phòng sạch tiêu chuẩn cao, cần xem yêu cầu kỹ thuật cụ thể."
msgstr ""

#: template-parts/landing/cards.php:68
msgid "Cửa hàng, kho nhỏ"
msgstr ""

#: template-parts/landing/cards.php:69
msgid "Ngăn kho hàng, khu nhân viên hoặc khu thao tác phía sau cửa hàng. Thi công gọn giúp mặt bằng kinh doanh sớm vận hành lại."
msgstr ""

#: template-parts/landing/cards.php:72
msgid "Trần panel chống nóng"
msgstr ""

#: template-parts/landing/cards.php:73
msgid "Một số công trình cần kết hợp trần panel để giảm nóng và làm mặt bằng gọn hơn. Cần xem cao độ, khung treo và hệ thống đèn/quạt."
msgstr ""

#: template-parts/landing/faq.php:16
msgid "Câu hỏi thường gặp về vách panel"
msgstr ""

#: template-parts/landing/faq.php:22
msgid "Thi công vách panel mất bao lâu?"
msgstr ""

#: template-parts/landing/faq.php:23
msgid "Tùy diện tích, chiều cao, loại panel và điều kiện mặt bằng. Vách nhỏ, mặt bằng trống thường nhanh hơn; công trình có nhiều cửa, ô kính, trần hoặc đang vận hành cần thêm thời gian tổ chức."
msgstr ""

#: template-parts/landing/faq.php:26
msgid "Panel có cách âm tốt không?"
msgstr ""

#: template-parts/landing/faq.php:27
msgid "Panel có thể giảm ồn ở mức nhất định, nhưng hiệu quả phụ thuộc loại lõi, độ dày, khe nối, cửa đi và trần/sàn. Nếu anh chị cần cách âm cao, cần nói rõ mục tiêu để tư vấn phương án phù hợp."
msgstr ""

#: template-parts/landing/faq.php:30
msgid "Panel có chống nóng không?"
msgstr ""

#: template-parts/landing/faq.php:31
msgid "Có, nhất là các loại panel có lõi cách nhiệt phù hợp. Tuy nhiên mức hiệu quả phụ thuộc loại panel, độ dày, hướng nắng, mái/trần và cách xử lý khe hở."
msgstr ""

#: template-parts/landing/faq.php:34
msgid "Có nhận diện tích nhỏ không?"
msgstr ""

#: template-parts/landing/faq.php:35
msgid "Có thể nhận nếu sắp xếp được thợ và vật tư theo khu vực. Anh chị gửi kích thước và vị trí để chúng tôi phản hồi nhanh."
msgstr ""

#: template-parts/landing/faq.php:38
msgid "Có làm kho lạnh hoặc phòng sạch không?"
msgstr ""

#: template-parts/landing/faq.php:39
msgid "Với kho lạnh/phòng sạch có tiêu chuẩn kỹ thuật riêng, Pro-Metal cần xem yêu cầu, bản vẽ và thông số vận hành trước. Nếu phù hợp năng lực và phạm vi, chúng tôi sẽ báo phương án; nếu không phù hợp sẽ nói rõ để anh chị tránh mất thời gian."
msgstr ""

#: template-parts/landing/faq.php:42
msgid "Có tháo dời, di chuyển vách panel cũ không?"
